import BrownianSharp.AlignmentFractionalGeometricPartition
import BrownianSharp.AlignmentAmbientWidth
import Mathlib.LinearAlgebra.Dimension.Basic
import Mathlib.Tactic

/-! Finite Hilbert spans generated by weighted local Taylor models. The
partition-weighted candidate may be discontinuous in the parameter; only its
pointwise membership in one fixed finite-dimensional span is used. -/

noncomputable section
open scoped BigOperators RealInnerProductSpace
open scoped ENNReal

namespace BrownianSharp.AlignmentFractionalHilbertTaylor

open BrownianSharp.AlignmentFractionalGeometricPartition
open HaarQuarter.TheoremD.Width

universe u
variable {H : Type u} {I : Type} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
variable [Fintype I]

/-- The fixed span of all coefficient vectors in the local Taylor family. -/
def taylorSpan (M : ℕ) (v : I → Fin M → H) : Submodule ℝ H :=
  Submodule.span ℝ (Set.range (fun p : I × Fin M => v p.1 p.2))

/-- The degree-`M-1` Taylor model centered at `center i`. -/
def localTaylor (M : ℕ) (v : I → Fin M → H) (center : I → ℝ)
    (i : I) (t : ℝ) : H :=
  ∑ k : Fin M, (t-center i)^(k.val) • v i k

/-- The weighted finite Taylor candidate. -/
def weightedTaylorCandidate (M : ℕ) (v : I → Fin M → H)
    (center : I → ℝ) (weight : I → ℝ → ℝ) (t : ℝ) : H :=
  ∑ i : I, weight i t • localTaylor M v center i t

theorem localTaylor_mem_taylorSpan (M : ℕ) (v : I → Fin M → H)
    (center : I → ℝ) (i : I) (t : ℝ) :
    localTaylor M v center i t ∈ taylorSpan M v := by
  unfold localTaylor taylorSpan
  apply Submodule.sum_mem
  intro k hk
  apply Submodule.smul_mem
  apply Submodule.subset_span
  exact ⟨(i,k),rfl⟩

theorem weightedTaylorCandidate_mem_taylorSpan (M : ℕ)
    (v : I → Fin M → H) (center : I → ℝ) (weight : I → ℝ → ℝ)
    (t : ℝ) : weightedTaylorCandidate M v center weight t ∈ taylorSpan M v := by
  unfold weightedTaylorCandidate
  apply Submodule.sum_mem
  intro i hi
  exact Submodule.smul_mem _ _ (localTaylor_mem_taylorSpan M v center i t)

/-- The coefficient span has dimension at most the number of Taylor
coefficients. -/
theorem taylorSpan_rank_le (M : ℕ) (v : I → Fin M → H) :
    Module.rank ℝ (taylorSpan M v) ≤ ((Fintype.card I)*M : Cardinal) := by
  classical
  let f : I × Fin M → H := fun p => v p.1 p.2
  let f' : ULift.{u} (I × Fin M) → H := fun p => f p.down
  have hrange : Set.range f = Set.range f' := by
    ext x
    constructor
    · rintro ⟨p,hp⟩
      exact ⟨ULift.up p,hp⟩
    · rintro ⟨p,hp⟩
      exact ⟨p.down,hp⟩
  change Module.rank ℝ (Submodule.span ℝ (Set.range f)) ≤ _
  rw [hrange]
  calc
    Module.rank ℝ (Submodule.span ℝ (Set.range f')) ≤
        Cardinal.mk (Set.range f') := rank_span_le _
    _ ≤ Cardinal.mk (ULift.{u} (I × Fin M)) := Cardinal.mk_range_le
    _ = ((Fintype.card I)*M : Cardinal) := by
      simp [Cardinal.mk_uLift, Cardinal.mk_fintype, f']

/-- If every active local Taylor model has residual at most `δ`, and the
unallocated remainder has kernel norm at most `η`, their weighted candidate
approximates the kernel uniformly. All hypotheses are pointwise. -/
theorem weightedTaylorCandidate_error
    (M : ℕ) (v : I → Fin M → H) (center : I → ℝ)
    (weight : I → ℝ → ℝ) (remainder : ℝ → ℝ) (K : ℝ → H)
    {t δ η : ℝ} (hδ : 0 ≤ δ) (hη : 0 ≤ η)
    (hweights : ∀ i, 0 ≤ weight i t)
    (hrem : 0 ≤ remainder t)
    (hmass : (∑ i : I, weight i t) + remainder t = 1)
    (hlocal : ∀ i, weight i t ≠ 0 →
      ‖K t-localTaylor M v center i t‖ ≤ δ)
    (htail : remainder t ≠ 0 → ‖K t‖ ≤ η) :
    ‖K t-weightedTaylorCandidate M v center weight t‖ ≤ δ+η := by
  classical
  let wsum : ℝ := ∑ i : I, weight i t
  let rem : ℝ := remainder t
  let cand : H := weightedTaylorCandidate M v center weight t
  have hsum_nonneg : 0 ≤ wsum := by
    dsimp [wsum]
    exact Finset.sum_nonneg fun i hi => hweights i
  have hsum_le : wsum ≤ 1 := by
    dsimp [wsum,rem] at hmass ⊢
    linarith [hrem]
  have hrem_le : rem ≤ 1 := by
    dsimp [rem]
    have := hmass
    have : 0 ≤ (∑ i : I, weight i t) := hsum_nonneg
    linarith
  have hdecomp : K t = (∑ i : I, weight i t • K t) + rem • K t := by
    calc
      K t = (1:ℝ) • K t := by simp
      _ = (wsum+rem) • K t := by rw [hmass]
      _ = wsum • K t + rem • K t := add_smul _ _ _
      _ = (∑ i : I, weight i t • K t) + rem • K t := by
        rw [Finset.sum_smul]
  have hsumdiff : (∑ i : I, weight i t • K t) -
      (∑ i : I, weight i t • localTaylor M v center i t) =
      ∑ i : I, weight i t • (K t-localTaylor M v center i t) := by
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i hi
    rw [smul_sub]
  have hdiff : K t-cand =
      (∑ i : I, weight i t • (K t-localTaylor M v center i t)) + rem • K t := by
    change K t-(∑ i : I, weight i t • localTaylor M v center i t) = _
    have h := congrArg (fun z : H => z -
      (∑ i : I, weight i t • localTaylor M v center i t)) hdecomp
    calc
      _ = ((∑ i : I, weight i t • K t) + rem • K t) -
          (∑ i : I, weight i t • localTaylor M v center i t) := h
      _ = ((∑ i : I, weight i t • K t) -
          (∑ i : I, weight i t • localTaylor M v center i t)) +
          rem • K t := by abel
      _ = _ := by rw [hsumdiff]
  have hsumres : ∑ i : I,
      ‖weight i t • (K t-localTaylor M v center i t)‖ ≤
      δ*wsum := by
    calc
      _ = ∑ i : I, (weight i t)*‖K t-localTaylor M v center i t‖ := by
        apply Finset.sum_congr rfl
        intro i hi
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hweights i)]
      _ ≤ ∑ i : I, (weight i t)*δ := by
        apply Finset.sum_le_sum
        intro i hi
        by_cases hwi : weight i t = 0
        · simp [hwi]
        · exact mul_le_mul_of_nonneg_left (hlocal i hwi) (hweights i)
      _ = δ*wsum := by
        dsimp [wsum]
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i hi
        ring
  have htailprod : rem*‖K t‖ ≤ rem*η := by
    by_cases hr : rem = 0
    · simp [hr]
    · exact mul_le_mul_of_nonneg_left (htail hr) hrem
  have hnorm : ‖K t-cand‖ ≤ δ*wsum+rem*η := by
    rw [hdiff]
    calc
      _ ≤ ‖∑ i : I, weight i t • (K t-localTaylor M v center i t)‖ +
          ‖rem • K t‖ := norm_add_le _ _
      _ ≤ (∑ i : I, ‖weight i t • (K t-localTaylor M v center i t)‖) +
          rem*‖K t‖ := by
        apply add_le_add
        · exact norm_sum_le _ _
        · rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hrem]
      _ ≤ δ*wsum+rem*η := add_le_add hsumres htailprod
  have hfinal : δ*wsum+rem*η ≤ δ+η := by
    have h1 : 0 ≤ δ*(1-wsum) := mul_nonneg hδ (sub_nonneg.mpr hsum_le)
    have h2 : 0 ≤ η*(1-rem) := mul_nonneg hη (sub_nonneg.mpr hrem_le)
    nlinarith
  exact hnorm.trans hfinal

/-- Uniform kernel approximation by one fixed finite Taylor span. -/
theorem exists_taylor_span_approximation
    (M : ℕ) (v : I → Fin M → H) (center : I → ℝ)
    (weight : I → ℝ → ℝ) (remainder : ℝ → ℝ) (K : ℝ → H)
    {δ η : ℝ} (hδ : 0 ≤ δ) (hη : 0 ≤ η)
    (hweights : ∀ t i, 0 ≤ weight i t)
    (hrem : ∀ t, 0 ≤ remainder t)
    (hmass : ∀ t, (∑ i : I, weight i t)+remainder t=1)
    (hlocal : ∀ t i, weight i t ≠ 0 →
      ‖K t-localTaylor M v center i t‖ ≤ δ)
    (htail : ∀ t, remainder t ≠ 0 → ‖K t‖ ≤ η) :
    ∀ t, ∃ u ∈ taylorSpan M v, ‖K t-u‖ ≤ δ+η := by
  intro t
  refine ⟨weightedTaylorCandidate M v center weight t,
    weightedTaylorCandidate_mem_taylorSpan M v center weight t, ?_⟩
  exact weightedTaylorCandidate_error M v center weight remainder K
    hδ hη (fun i => hweights t i) (hrem t) (hmass t)
    (hlocal t) (htail t)

/-- A pointwise weighted Taylor construction gives an actual Kolmogorov-width
bound for any parameterized family. The coefficient subspace is chosen once,
independently of the parameter. -/
theorem weighted_taylor_family_width
    (M : ℕ) (v : I → Fin M → H) (center : I → ℝ)
    (weight : I → ℝ → ℝ) (remainder : ℝ → ℝ) (K : ℝ → H)
    (A : Set ℝ) {δ η : ℝ} (hδ : 0 ≤ δ) (hη : 0 ≤ η)
    (hweights : ∀ t, t ∈ A → ∀ i, 0 ≤ weight i t)
    (hrem : ∀ t, t ∈ A → 0 ≤ remainder t)
    (hmass : ∀ t, t ∈ A → (∑ i : I, weight i t)+remainder t=1)
    (hlocal : ∀ t, t ∈ A → ∀ i, weight i t ≠ 0 →
      ‖K t-localTaylor M v center i t‖ ≤ δ)
    (htail : ∀ t, t ∈ A → remainder t ≠ 0 → ‖K t‖ ≤ η) :
    kolmogorovWidth (K '' A) (Fintype.card I * M) ≤
      ENNReal.ofReal (δ+η) := by
  classical
  let U := taylorSpan M v
  have hUrank : Module.rank ℝ U ≤ ((Fintype.card I * M : ℕ) : Cardinal) := by
    simpa [U, Nat.cast_mul] using taylorSpan_rank_le M v
  have hpoint : ∀ x ∈ K '' A, ∃ y ∈ U, ‖x-y‖ ≤ δ+η := by
    rintro x ⟨t, ht, rfl⟩
    refine ⟨weightedTaylorCandidate M v center weight t, ?_, ?_⟩
    · simpa [U] using weightedTaylorCandidate_mem_taylorSpan M v center
        weight t
    · exact weightedTaylorCandidate_error M v center weight remainder K
        hδ hη (fun i => hweights t ht i) (hrem t ht) (hmass t ht)
        (hlocal t ht) (htail t ht)
  have herror : approximationError (K '' A) U ≤ ENNReal.ofReal (δ+η) :=
    BrownianSharp.AlignmentAmbientWidth.approximationError_le_of_pointwise
      (K '' A) U (add_nonneg hδ hη) hpoint
  unfold kolmogorovWidth
  calc
    _ ≤ approximationError (K '' A) U := iInf_le
      (fun V : {V : Submodule ℝ H // Module.rank ℝ V ≤
          ((Fintype.card I * M : ℕ) : Cardinal)} =>
        approximationError (K '' A) V.val) ⟨U,hUrank⟩
    _ ≤ ENNReal.ofReal (δ+η) := herror

end BrownianSharp.AlignmentFractionalHilbertTaylor
