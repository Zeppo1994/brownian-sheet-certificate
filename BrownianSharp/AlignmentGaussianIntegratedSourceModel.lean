import BrownianSharp.AlignmentGaussianBochner
import BrownianSharp.AlignmentGaussianIntegratedFiniteProjection
import BrownianSharp.GaussianProjection
import Mathlib.Probability.Distributions.Gaussian.Multivariate
import Mathlib.Probability.Distributions.Gaussian.HasGaussianLaw.Basic
import Mathlib.Tactic

/-! A finite-dimensional isonormal model built directly on `UnitCubeL2`.

This module provides a Gaussian comparison model for any finite collection of
source vectors and integrated-kernel feature vectors. It avoids requiring those
source vectors to lie in the anchored-box span used by the Brownian realization.
-/
noncomputable section
open MeasureTheory ProbabilityTheory InnerProductSpace
open scoped BigOperators RealInnerProductSpace

namespace BrownianSharp.AlignmentGaussianIntegratedSourceModel

open HaarQuarter
open BrownianSharp.AlignmentGaussianBochner
open BrownianSharp.AlignmentFractionalTensorOperator
open BrownianSharp.GaussianProjection

/-- The finite-dimensional source space generated by a finite feature family. -/
def finiteSourceSpan {d : ℕ} {κ : Type*} [Fintype κ]
    (v : κ → CameronMartin.UnitCubeL2 d) : Submodule ℝ (CameronMartin.UnitCubeL2 d) :=
  Submodule.span ℝ (Set.range v)

instance finiteSourceSpan_finiteDimensional {d : ℕ} {κ : Type*} [Fintype κ]
    (v : κ → CameronMartin.UnitCubeL2 d) :
    FiniteDimensional ℝ (finiteSourceSpan v) :=
  FiniteDimensional.span_of_finite ℝ (Set.finite_range v)

instance finiteSourceSpan_measurableSpace {d : ℕ} {κ : Type*} [Fintype κ]
    (v : κ → CameronMartin.UnitCubeL2 d) :
    MeasurableSpace (finiteSourceSpan v) := borel (finiteSourceSpan v)

instance finiteSourceSpan_borelSpace {d : ℕ} {κ : Type*} [Fintype κ]
    (v : κ → CameronMartin.UnitCubeL2 d) :
    BorelSpace (finiteSourceSpan v) := ⟨rfl⟩

/-- Coordinatewise inner products against a finite list of vectors form a
continuous linear map from the source space into a finite real product. -/
def innerCoordinates {E κ : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [Fintype κ] (v : κ → E) : E →L[ℝ] (κ → ℝ) :=
  ContinuousLinearMap.pi fun i => innerSL ℝ (v i)

@[simp] theorem innerCoordinates_apply {E κ : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [Fintype κ] (v : κ → E) (x : E) (i : κ) :
    innerCoordinates v x i = ⟪v i, x⟫ := rfl

/-- Restrict the standard Gaussian on the finite span to an isonormal family.
The ambient feature family is retained in the index type so its coordinates
are available together with the selected source coordinates. -/
def finiteSourceIsonormal {d : ℕ} {κ : Type*} [Fintype κ]
    (v : κ → CameronMartin.UnitCubeL2 d) :
    IsonormalGaussianFamily (finiteSourceSpan v) (finiteSourceSpan v) κ
      (stdGaussian (finiteSourceSpan v)) := by
  let S := finiteSourceSpan v
  refine {
    eval := fun f ω => ⟪f, ω⟫
    jointlyGaussian := ?_
    measurable_eval := ?_
    mean_zero := ?_
    covariance_eq_inner := ?_ }
  · intro w
    let L : S →L[ℝ] (κ → ℝ) := innerCoordinates w
    have hbase : HasGaussianLaw id (stdGaussian S) :=
      ProbabilityTheory.IsGaussian.hasGaussianLaw_id
    have hmap := hbase.map L
    have heq : (fun ω i => ⟪w i, ω⟫) = L := by
      funext ω i
      rfl
    rw [heq]
    exact hmap
  · intro f
    exact (innerSL ℝ f).continuous.measurable
  · intro f
    let L : S →L[ℝ] ℝ := innerSL ℝ f
    have hidmem : MemLp (id : S → S) 2 (stdGaussian S) :=
      (ProbabilityTheory.IsGaussian.hasGaussianLaw_id
        (μ := stdGaussian S)).memLp_two
    have hid : Integrable (fun x : S => x) (stdGaussian S) :=
      hidmem.integrable (by norm_num)
    have h := L.integral_comp_comm hid
    rw [ProbabilityTheory.integral_id_stdGaussian] at h
    simpa [L] using h
  · intro f g
    have hid : MemLp (id : S → S) 2 (stdGaussian S) :=
      (ProbabilityTheory.IsGaussian.hasGaussianLaw_id
        (μ := stdGaussian S)).memLp_two
    have hcov := ProbabilityTheory.covarianceBilin_apply_eq_cov hid f g
    rw [ProbabilityTheory.covarianceBilin_stdGaussian] at hcov
    exact hcov.symm

/-- A finite model for selected orthonormal source coordinates and arbitrary
finite evaluation features. The evaluation side and selected coefficients are
independent after orthogonal projection, and all selected coordinates are
independent standard normals. -/
theorem exists_finiteSourceProjection_model
    {d : ℕ} {I J : Type*} [Fintype I] [DecidableEq I] [Nonempty I] [Fintype J]
    (e : I → CameronMartin.UnitCubeL2 d)
    (v : J → CameronMartin.UnitCubeL2 d)
    (he : ∀ i j, ⟪e i, e j⟫ = if i = j then 1 else 0) :
    ∃ W : IsonormalGaussianFamily
      (finiteSourceSpan (Sum.elim e v))
      (finiteSourceSpan (Sum.elim e v)) (Sum I J)
      (stdGaussian (finiteSourceSpan (Sum.elim e v))),
      iIndepFun (fun i ω => W.eval
        (⟨e i, Submodule.subset_span ⟨Sum.inl i, rfl⟩⟩ : finiteSourceSpan (Sum.elim e v)) ω)
        (stdGaussian (finiteSourceSpan (Sum.elim e v))) ∧
      (∀ i, (stdGaussian (finiteSourceSpan (Sum.elim e v))).map
        (W.eval (⟨e i, Submodule.subset_span ⟨Sum.inl i, rfl⟩⟩ :
          finiteSourceSpan (Sum.elim e v))) = gaussianReal 0 1) ∧
      IndepFun
        (fun ω i => W.eval
          (⟨e i, Submodule.subset_span ⟨Sum.inl i, rfl⟩⟩ :
            finiteSourceSpan (Sum.elim e v)) ω)
        (fun ω j => W.eval
          ((⟨v j, Submodule.subset_span ⟨Sum.inr j, rfl⟩⟩ :
            finiteSourceSpan (Sum.elim e v)) -
          projection
            (fun i => (⟨e i, Submodule.subset_span ⟨Sum.inl i, rfl⟩⟩ :
              finiteSourceSpan (Sum.elim e v)))
            (⟨v j, Submodule.subset_span ⟨Sum.inr j, rfl⟩⟩ :
              finiteSourceSpan (Sum.elim e v))) ω)
        (stdGaussian (finiteSourceSpan (Sum.elim e v))) := by
  let W := finiteSourceIsonormal (Sum.elim e v)
  let eb : I → finiteSourceSpan (Sum.elim e v) := fun i =>
    ⟨e i, Submodule.subset_span ⟨Sum.inl i, rfl⟩⟩
  let vb : J → finiteSourceSpan (Sum.elim e v) := fun j =>
    ⟨v j, Submodule.subset_span ⟨Sum.inr j, rfl⟩⟩
  have heb : ∀ i j, ⟪eb i, eb j⟫ = if i = j then 1 else 0 := by
    intro i j
    exact he i j
  refine ⟨W, ?_, ?_, ?_⟩
  · exact coefficients_independent W eb vb heb
  · intro i
    exact coefficient_standard_normal W eb vb heb i
  · exact coefficients_residual_independent W eb vb heb

/-- The source-space feature of an integer integrated sheet evaluation is the
Gamma-normalized tensor Riemann--Liouville kernel. -/
noncomputable def integerIntegratedKernelFeature {d : ℕ} (m : Fin d → ℕ) :
    BrownianCubeAnchor d → CameronMartin.UnitCubeL2 d :=
  tensorKernelFamily (fun i => (m i : ℝ) + 1)
    (by intro i; have h : 0 ≤ (m i : ℝ) := Nat.cast_nonneg _; linarith)

theorem integratedFeature_embedding_eq_kernel {d : ℕ} (m : Fin d → ℕ)
    (x : BrownianCubeAnchor d) :
    brownianCubeSpanEmbedding d (integratedFeatureField m x) =
      unitCubeZeroExtendCLM d (integerIntegratedKernelFeature m x) := by
  rw [integrateSheetFeatureField_naturalTensor, naturalTensorFeature_eq_fractionalKernel]
  rfl

private def piToEuclidean {J : Type*} [Fintype J] : (J → ℝ) →L[ℝ] EuclideanSpace ℝ J :=
  (EuclideanSpace.equiv J ℝ).symm.toContinuousLinearMap

private def finiteUnivEquiv {J : Type*} [Fintype J] :
    (↥(Finset.univ : Finset J)) ≃ J :=
  { toFun := fun i => i.1
    invFun := fun j => ⟨j, Finset.mem_univ j⟩
    left_inv := by intro i; apply Subtype.ext; rfl
    right_inv := by intro j; rfl }

private def gridVector {J Ω : Type*} [Fintype J] (X : J → Ω → ℝ) (ω : Ω) :
    EuclideanSpace ℝ J := WithLp.toLp 2 (fun j => X j ω)

private theorem integratedGrid_hasGaussianLaw
    {d : ℕ} {Ω J : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsProbabilityMeasure P] [Fintype J] (B : BrownianSheetOnCube d Ω P)
    (m : Fin d → ℕ) (x : J → BrownianCubeAnchor d) :
    HasGaussianLaw (gridVector (fun j ω =>
      BrownianSharp.AlignmentGaussianRates.integrateSheetPath m (B.path ω) (x j))) P := by
  let hproc := (integratedSheetPath_isGaussianProcess B m).comp_right x
  have hraw := hproc.hasGaussianLaw Finset.univ
  let R : ((↥(Finset.univ : Finset J)) → ℝ) ≃L[ℝ] (J → ℝ) :=
    ContinuousLinearEquiv.piCongrLeft ℝ (fun _ : J => ℝ) finiteUnivEquiv
  have hpi := hraw.map_equiv R
  have heq : (fun ω j =>
      BrownianSharp.AlignmentGaussianRates.integrateSheetPath m (B.path ω) (x j)) =
      (fun ω => R (fun i =>
        BrownianSharp.AlignmentGaussianRates.integrateSheetPath m (B.path ω) (x i.1))) := by
    funext ω j
    rfl
  have hpi' : HasGaussianLaw (fun ω j =>
      BrownianSharp.AlignmentGaussianRates.integrateSheetPath m (B.path ω) (x j)) P := by
    rw [heq]
    change HasGaussianLaw (fun ω => R (fun i =>
      BrownianSharp.AlignmentGaussianRates.integrateSheetPath m (B.path ω) (x i.1))) P
    exact hpi
  exact hpi'.map piToEuclidean

/-- Lift one selected vector into the finite source span. -/
def sourceFrameLift {d : ℕ} {I J : Type*} [Fintype I] [Fintype J]
    (e : I → CameronMartin.UnitCubeL2 d) (v : J → CameronMartin.UnitCubeL2 d) (i : I) :
    finiteSourceSpan (Sum.elim e v) :=
  ⟨e i, Submodule.subset_span ⟨Sum.inl i, rfl⟩⟩

/-- Lift one evaluation feature into the finite source span. -/
def sourceFeatureLift {d : ℕ} {I J : Type*} [Fintype I] [Fintype J]
    (e : I → CameronMartin.UnitCubeL2 d) (v : J → CameronMartin.UnitCubeL2 d) (j : J) :
    finiteSourceSpan (Sum.elim e v) :=
  ⟨v j, Submodule.subset_span ⟨Sum.inr j, rfl⟩⟩

/-- The model vector has the same finite-dimensional Gaussian law as the
actual integer-integrated sheet grid. It is built on the finite span of the
chosen source frame and all RL kernel feature vectors, so those directions and
their orthogonal residual coexist in one genuine finite-dimensional Gaussian
model. -/
theorem integratedGrid_law_eq_finiteSourceModel
    {d : ℕ} {Ω I J : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsProbabilityMeasure P] [Fintype I] [DecidableEq I] [Nonempty I] [Fintype J]
    (B : BrownianSheetOnCube d Ω P) (m : Fin d → ℕ)
    (e : I → CameronMartin.UnitCubeL2 d)
    (he : ∀ i j, ⟪e i, e j⟫ = if i = j then 1 else 0)
    (x : J → BrownianCubeAnchor d) :
    ∃ W : IsonormalGaussianFamily
      (finiteSourceSpan (Sum.elim e (integerIntegratedKernelFeature m ∘ x)))
      (finiteSourceSpan (Sum.elim e (integerIntegratedKernelFeature m ∘ x))) (Sum I J)
      (stdGaussian (finiteSourceSpan (Sum.elim e (integerIntegratedKernelFeature m ∘ x)))),
      Measure.map
        (gridVector (fun j ω =>
          BrownianSharp.AlignmentGaussianRates.integrateSheetPath m (B.path ω) (x j))) P =
      Measure.map
        (gridVector (fun j ω => W.eval
          (sourceFeatureLift e (integerIntegratedKernelFeature m ∘ x) j) ω))
        (stdGaussian (finiteSourceSpan (Sum.elim e (integerIntegratedKernelFeature m ∘ x)))) ∧
      iIndepFun (fun i ω => W.eval
        (sourceFrameLift e (integerIntegratedKernelFeature m ∘ x) i) ω)
        (stdGaussian (finiteSourceSpan (Sum.elim e (integerIntegratedKernelFeature m ∘ x)))) ∧
      (∀ i, (stdGaussian (finiteSourceSpan (Sum.elim e (integerIntegratedKernelFeature m ∘ x)))).map
        (W.eval (sourceFrameLift e (integerIntegratedKernelFeature m ∘ x) i)) = gaussianReal 0 1) ∧
      IndepFun
        (fun ω i => W.eval
          (sourceFrameLift e (integerIntegratedKernelFeature m ∘ x) i) ω)
        (fun ω j => W.eval
          (sourceFeatureLift e (integerIntegratedKernelFeature m ∘ x) j -
            projection
              (sourceFrameLift e (integerIntegratedKernelFeature m ∘ x))
              (sourceFeatureLift e (integerIntegratedKernelFeature m ∘ x) j)) ω)
        (stdGaussian (finiteSourceSpan (Sum.elim e (integerIntegratedKernelFeature m ∘ x)))) := by
  classical
  let v : J → CameronMartin.UnitCubeL2 d := integerIntegratedKernelFeature m ∘ x
  let S := finiteSourceSpan (Sum.elim e v)
  let eb : I → S := fun i => ⟨e i, Submodule.subset_span ⟨Sum.inl i, rfl⟩⟩
  let vb : J → S := fun j => ⟨v j, Submodule.subset_span ⟨Sum.inr j, rfl⟩⟩
  let W := finiteSourceIsonormal (Sum.elim e v)
  have heb : ∀ i j, ⟪eb i, eb j⟫ = if i = j then 1 else 0 := by
    intro i j
    exact he i j
  have hactual := integratedGrid_hasGaussianLaw B m x
  have hmodelPi : HasGaussianLaw (fun ω j => ⟪vb j, ω⟫) (stdGaussian S) := by
    let L : S →L[ℝ] (J → ℝ) := innerCoordinates vb
    have hbase : HasGaussianLaw id (stdGaussian S) :=
      ProbabilityTheory.IsGaussian.hasGaussianLaw_id
    have h := hbase.map L
    change HasGaussianLaw (fun ω j => ⟪vb j, ω⟫) (stdGaussian S)
    exact h
  have hmodel := hmodelPi.map piToEuclidean
  have hactualMean (j : J) : ∫ ω,
      BrownianSharp.AlignmentGaussianRates.integrateSheetPath m (B.path ω) (x j) ∂P = 0 := by
    obtain ⟨T, W₀, hW₀, hPath⟩ := integratedSheetPath_ae_eq_isonormal B m
    calc
      _ = ∫ ω, T (integratedFeatureField m (x j)) ω ∂P := integral_congr_ae (hPath (x j))
      _ = ∫ ω, W₀.eval (integratedFeatureField m (x j)) ω ∂P :=
        integral_congr_ae (hW₀ (integratedFeatureField m (x j))).symm
      _ = 0 := W₀.mean_zero _
  have hmodelMean (j : J) : ∫ ω, W.eval (vb j) ω ∂stdGaussian S = 0 :=
    W.mean_zero (vb j)
  have hcov (i j : J) :
      covariance (fun ω => BrownianSharp.AlignmentGaussianRates.integrateSheetPath
        m (B.path ω) (x i))
        (fun ω => BrownianSharp.AlignmentGaussianRates.integrateSheetPath
          m (B.path ω) (x j)) P =
      covariance (fun ω => W.eval (vb i) ω) (fun ω => W.eval (vb j) ω) (stdGaussian S) := by
    rw [integratedSheetPath_covariance B m (x i) (x j), W.covariance_eq_inner]
    rw [← (brownianCubeSpanEmbedding d).inner_map_map,
      integratedFeature_embedding_eq_kernel, integratedFeature_embedding_eq_kernel,
      unitCubeZeroExtendCLM_inner]
    rfl
  let μA := Measure.map
    (gridVector (fun j ω => BrownianSharp.AlignmentGaussianRates.integrateSheetPath
      m (B.path ω) (x j))) P
  let μM := Measure.map
    (gridVector (fun j ω => W.eval (vb j) ω)) (stdGaussian S)
  have hAis : IsGaussian μA := hactual.isGaussian_map
  have hMis : IsGaussian μM := hmodel.isGaussian_map
  have hAcoord : ∀ j, MemLp (fun ω =>
      BrownianSharp.AlignmentGaussianRates.integrateSheetPath m (B.path ω) (x j)) 2 P := by
    intro j
    let hproc := (integratedSheetPath_isGaussianProcess B m).comp_right x
    have hpi := hproc.hasGaussianLaw Finset.univ
    have hcoord := hpi.eval ⟨j, Finset.mem_univ j⟩
    simpa using hcoord.memLp_two
  have hMcoord : ∀ j, MemLp (fun ω => W.eval (vb j) ω) 2 (stdGaussian S) := by
    intro j
    change MemLp (fun ω => ⟪vb j, ω⟫) 2 (stdGaussian S)
    exact (hmodelPi.eval j).memLp_two
  have hPiIntA : Integrable (fun ω j =>
      BrownianSharp.AlignmentGaussianRates.integrateSheetPath m (B.path ω) (x j)) P :=
    integrable_pi_iff.mpr (fun j => (hAcoord j).integrable (by norm_num))
  have hPiIntM : Integrable (fun ω j => W.eval (vb j) ω) (stdGaussian S) :=
    integrable_pi_iff.mpr (fun j => (hMcoord j).integrable (by norm_num))
  have hEquivIntA : Integrable (fun ω => (EuclideanSpace.equiv J ℝ)
      (gridVector (fun j ω => BrownianSharp.AlignmentGaussianRates.integrateSheetPath
        m (B.path ω) (x j)) ω)) P := by
    apply integrable_pi_iff.mpr
    intro j
    simpa [gridVector] using (hAcoord j).integrable (by norm_num)
  have hEquivIntM : Integrable (fun ω => (EuclideanSpace.equiv J ℝ)
      (gridVector (fun j ω => W.eval (vb j) ω) ω)) (stdGaussian S) := by
    apply integrable_pi_iff.mpr
    intro j
    simpa [gridVector] using (hMcoord j).integrable (by norm_num)
  have hmeanA : ∫ z : EuclideanSpace ℝ J, z ∂μA = 0 := by
    apply (EuclideanSpace.equiv J ℝ).injective
    have hcomp := (EuclideanSpace.equiv J ℝ).toContinuousLinearMap.integral_comp_comm
      (IsGaussian.integrable_id (μ := μA))
    calc
      (EuclideanSpace.equiv J ℝ) (∫ z, z ∂μA) = ∫ z, (EuclideanSpace.equiv J ℝ) z ∂μA :=
        hcomp.symm
      _ = ∫ ω, (EuclideanSpace.equiv J ℝ) (gridVector
          (fun j ω => BrownianSharp.AlignmentGaussianRates.integrateSheetPath
            m (B.path ω) (x j)) ω) ∂P :=
        MeasureTheory.integral_map hactual.aemeasurable (by fun_prop)
      _ = 0 := by
        ext j
        let q : (J → ℝ) →L[ℝ] ℝ := ContinuousLinearMap.proj j
        have hproj := q.integral_comp_comm hEquivIntA
        calc
          (∫ ω, (EuclideanSpace.equiv J ℝ) (gridVector
              (fun j ω => BrownianSharp.AlignmentGaussianRates.integrateSheetPath
                m (B.path ω) (x j)) ω) ∂P) j =
              q (∫ ω, (EuclideanSpace.equiv J ℝ) (gridVector
                (fun j ω => BrownianSharp.AlignmentGaussianRates.integrateSheetPath
                  m (B.path ω) (x j)) ω) ∂P) := rfl
          _ = ∫ ω, q ((EuclideanSpace.equiv J ℝ) (gridVector
                (fun j ω => BrownianSharp.AlignmentGaussianRates.integrateSheetPath
                  m (B.path ω) (x j)) ω)) ∂P := hproj.symm
          _ = ∫ ω, BrownianSharp.AlignmentGaussianRates.integrateSheetPath
                m (B.path ω) (x j) ∂P := by
              congr 1 <;> simp [q, gridVector]
          _ = 0 := hactualMean j
  have hmeanM : ∫ z : EuclideanSpace ℝ J, z ∂μM = 0 := by
    apply (EuclideanSpace.equiv J ℝ).injective
    have hcomp := (EuclideanSpace.equiv J ℝ).toContinuousLinearMap.integral_comp_comm
      (IsGaussian.integrable_id (μ := μM))
    calc
      (EuclideanSpace.equiv J ℝ) (∫ z, z ∂μM) = ∫ z, (EuclideanSpace.equiv J ℝ) z ∂μM :=
        hcomp.symm
      _ = ∫ ω, (EuclideanSpace.equiv J ℝ) (gridVector
          (fun j ω => W.eval (vb j) ω) ω) ∂(stdGaussian S) :=
        MeasureTheory.integral_map hmodel.aemeasurable (by fun_prop)
      _ = 0 := by
        ext j
        let q : (J → ℝ) →L[ℝ] ℝ := ContinuousLinearMap.proj j
        have hproj := q.integral_comp_comm hEquivIntM
        calc
          (∫ ω, (EuclideanSpace.equiv J ℝ) (gridVector (fun j ω => W.eval (vb j) ω) ω)
              ∂(stdGaussian S)) j =
              q (∫ ω, (EuclideanSpace.equiv J ℝ)
                (gridVector (fun j ω => W.eval (vb j) ω) ω) ∂(stdGaussian S)) := rfl
          _ = ∫ ω, q ((EuclideanSpace.equiv J ℝ)
                (gridVector (fun j ω => W.eval (vb j) ω) ω)) ∂(stdGaussian S) := hproj.symm
          _ = ∫ ω, W.eval (vb j) ω ∂(stdGaussian S) := by
              congr 1 <;> simp [q, gridVector]
          _ = 0 := hmodelMean j
  have hcovBilin : covarianceBilin μA = covarianceBilin μM := by
    rw [← ContinuousLinearMap.toBilinForm_inj]
    refine LinearMap.BilinForm.ext_basis (EuclideanSpace.basisFun J ℝ).toBasis fun i j => ?_
    rw [ContinuousLinearMap.toBilinForm_apply, ContinuousLinearMap.toBilinForm_apply]
    change covarianceBilin (Measure.map (fun ω => WithLp.toLp 2 fun j =>
      BrownianSharp.AlignmentGaussianRates.integrateSheetPath m (B.path ω) (x j)) P) _ _ =
      covarianceBilin (Measure.map (fun ω => WithLp.toLp 2 fun j => W.eval (vb j) ω)
        (stdGaussian S)) _ _
    rw [covarianceBilin_apply_pi hAcoord, covarianceBilin_apply_pi hMcoord]
    simp_rw [hcov]
  have hμeq : μA = μM := IsGaussian.ext (by simpa using hmeanA.trans hmeanM.symm) hcovBilin
  refine ⟨W, ?_, ?_, ?_, ?_⟩
  · exact hμeq
  · exact coefficients_independent W eb vb heb
  · intro i
    exact coefficient_standard_normal W eb vb heb i
  · exact coefficients_residual_independent W eb vb heb

end BrownianSharp.AlignmentGaussianIntegratedSourceModel
