import BrownianSharp.AlignmentPaperGenericGradedHilbert
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.Algebra.Ring.GeomSum

/-! Cumulative nesting for independently constructed finite-dimensional
approximant spaces, with rank and projection-error transfer. -/

noncomputable section
open scoped BigOperators RealInnerProductSpace

namespace BrownianSharp.AlignmentPaperCumulativeFiltration

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [CompleteSpace E]

/-- The level-N space generated by every candidate space through level N. -/
def cumulativeFiltration (V : ℕ → Submodule ℝ E) (N : ℕ) : Submodule ℝ E :=
  (Finset.range (N+1)).sup V

theorem cumulativeFiltration_finiteDimensional (V : ℕ → Submodule ℝ E)
    (hfinite : ∀ n, FiniteDimensional ℝ (V n)) (N : ℕ) :
    FiniteDimensional ℝ ↥(cumulativeFiltration V N) := by
  classical
  letI : ∀ n, FiniteDimensional ℝ (V n) := hfinite
  exact Submodule.finite_finset_sup (Finset.range (N+1)) V

theorem cumulativeFiltration_nested (V : ℕ → Submodule ℝ E) (N : ℕ) :
    cumulativeFiltration V N ≤ cumulativeFiltration V (N+1) := by
  apply Finset.sup_le
  intro n hn
  apply Finset.le_sup (s := Finset.range (N+2)) (f := V)
  simp only [Finset.mem_range] at hn ⊢
  omega

private theorem finrank_finset_sup_le_sum {ι : Type*} (s : Finset ι)
    (V : ι → Submodule ℝ E) (hfinite : ∀ i, FiniteDimensional ℝ (V i)) :
    Module.finrank ℝ ↥(s.sup V) ≤ ∑ i ∈ s, Module.finrank ℝ ↥(V i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s has ih =>
      letI : ∀ i, FiniteDimensional ℝ (V i) := hfinite
      letI : FiniteDimensional ℝ ↥(s.sup V) := Submodule.finite_finset_sup s V
      have hdim := Submodule.finrank_add_le_finrank_add_finrank (V a) (s.sup V)
      rw [Finset.sup_insert]
      calc
        Module.finrank ℝ ↥(V a ⊔ s.sup V) ≤
            Module.finrank ℝ ↥(V a) + Module.finrank ℝ ↥(s.sup V) := hdim
        _ ≤ Module.finrank ℝ ↥(V a) + ∑ i ∈ s, Module.finrank ℝ ↥(V i) :=
          Nat.add_le_add_left ih _
        _ = ∑ i ∈ insert a s, Module.finrank ℝ ↥(V i) := by simp [has]

/-- If level n has rank at most D·2^n, the cumulative nested space has rank
at most 2D·2^N. -/
theorem cumulativeFiltration_finrank_le (V : ℕ → Submodule ℝ E)
    (hfinite : ∀ n, FiniteDimensional ℝ (V n)) {D : ℕ}
    (hgrowth : ∀ n, Module.finrank ℝ ↥(V n) ≤ D*2^n) (N : ℕ) :
    Module.finrank ℝ ↥(cumulativeFiltration V N) ≤ (2*D)*2^N := by
  classical
  calc
    Module.finrank ℝ ↥(cumulativeFiltration V N) ≤
        ∑ n ∈ Finset.range (N+1), Module.finrank ℝ ↥(V n) :=
      finrank_finset_sup_le_sum _ _ hfinite
    _ ≤ ∑ n ∈ Finset.range (N+1), D*2^n :=
      Finset.sum_le_sum fun n hn => hgrowth n
    _ = D * ∑ n ∈ Finset.range (N+1), 2^n := by rw [Finset.mul_sum]
    _ = D * (2^(N+1)-1) := by
      rw [Nat.geomSum_eq (by norm_num : 2 ≤ 2) (N+1)]
      simp
    _ ≤ D * 2^(N+1) := Nat.mul_le_mul_left D (Nat.sub_le _ _)
    _ = (2*D)*2^N := by rw [pow_succ]; ring

/-- A level-N approximant remains available in the cumulative space, so its
error bounds the orthogonal-projection residual there. -/
theorem cumulative_candidate_mem (V : ℕ → Submodule ℝ E)
    (N : ℕ) (w : E) (hw : w ∈ V N) :
    w ∈ cumulativeFiltration V N := by
  exact Finset.le_sup (s := Finset.range (N+1)) (f := V)
    (Finset.mem_range.mpr (by omega)) hw

/-- Orthogonal projection onto any complete submodule is no worse than an
available approximant in that submodule. -/
theorem projection_residual_le_of_candidate
    (U : Submodule ℝ E) [U.HasOrthogonalProjection]
    (N : ℕ) (x w : E) (hw : w ∈ U) :
    ‖x - U.starProjection x‖ ≤ ‖x-w‖ := by
  rw [Submodule.starProjection_minimal]
  have hbdd : BddBelow (Set.range fun y : U => ‖x - (y : E)‖) := by
    refine ⟨0, ?_⟩
    rintro z ⟨y, rfl⟩
    exact norm_nonneg _
  have hle := ciInf_le hbdd (⟨w,hw⟩ : U)
  simpa using hle

end BrownianSharp.AlignmentPaperCumulativeFiltration
