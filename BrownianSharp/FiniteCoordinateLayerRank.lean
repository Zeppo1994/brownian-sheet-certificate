import BrownianSharp.FiniteCoordinateLayers

/-! A row map restricted to one coordinate layer has an exact finite-rank
approximating space, generated by the coordinate slices of its rows. -/

noncomputable section
open scoped BigOperators RealInnerProductSpace

namespace BrownianSharp

variable {I J G : Type} [Fintype I] [Fintype J] [Fintype G]
  [DecidableEq J]

def finiteLayerRowAtom (σ : I → J) (v : G → EuclideanSpace ℝ I) (j : J) :
    {i : I // σ i = j} → G → ℝ := fun i g => v g i.1

def finiteLayerRowSpan (σ : I → J) (v : G → EuclideanSpace ℝ I) (j : J) :
    Submodule ℝ (G → ℝ) :=
  Submodule.span ℝ (Set.range (finiteLayerRowAtom σ v j))

theorem finiteLayerRowSpan_finrank_le (σ : I → J)
    (v : G → EuclideanSpace ℝ I) (j : J) :
    Module.finrank ℝ (finiteLayerRowSpan σ v j) ≤ Fintype.card {i : I // σ i = j} := by
  have h := finrank_range_le_card (R:=ℝ) (finiteLayerRowAtom σ v j)
  change Module.finrank ℝ (finiteLayerRowSpan σ v j) ≤
    Fintype.card {i : I // σ i = j} at h
  exact h

theorem finiteRowLayerLinear_mem_finiteLayerRowSpan (σ : I → J)
    (v : G → EuclideanSpace ℝ I) (j : J) (x : EuclideanSpace ℝ I) :
    finiteRowLayerLinear σ v j x ∈ finiteLayerRowSpan σ v j := by
  classical
  let F := {i : I // σ i = j}
  let b : F → G → ℝ := finiteLayerRowAtom σ v j
  have hsum : finiteRowLayerLinear σ v j x =
      ∑ i : F, (x i.1) • b i := by
    funext g
    rw [finiteRowLayerLinear_eq_comp, LinearMap.comp_apply]
    change ⟪coordinateLayerMask σ j x, v g⟫ = _
    rw [← inner_coordinateLayerMask]
    simp only [EuclideanSpace.inner_eq_star_dotProduct, dotProduct, star_trivial]
    have hsumSubtype :
        (∑ i : I, if σ i = j then x i * v g i else 0) =
          ∑ i : F, x i.1 * v g i.1 := by
      let f : I → ℝ := fun i => x i * v g i
      calc
        _ = ∑ i ∈ Finset.univ with σ i = j, f i := by
          rw [Finset.sum_filter]
        _ = ∑ i : F, f i.1 := by
          exact Finset.sum_subtype (Finset.univ.filter (fun i => σ i = j))
            (by intro i; simp) f
    simpa [coordinateLayerMask_apply, F, b, finiteLayerRowAtom, mul_comm] using hsumSubtype
  rw [hsum]
  apply Submodule.sum_mem
  intro i hi
  apply Submodule.smul_mem
  exact Submodule.subset_span ⟨i, rfl⟩

end BrownianSharp
