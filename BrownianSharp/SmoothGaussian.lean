import BrownianSharp.SmoothVariance
import BrownianSharp.GaussianGridStatistics
import BrownianSharp.ShellVariance

/-! Actual finite Gaussian rows generated by the concrete periodic smooth
plateau layer. The covariance is the full dot product of the smooth atom
coefficient vectors; no independent-row surrogate is introduced. -/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped BigOperators

namespace BrownianSharp

theorem smoothGoodGrid_variance_pos {d n : ℕ} (hd : 0 < d)
    (q : SmoothGoodGrid d n) : 0 < smoothLayerVariance q.1 :=
  (half_pos (smoothVarianceMeanLowerBound_pos hd)).trans_le q.2

end BrownianSharp
