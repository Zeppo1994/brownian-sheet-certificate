import BrownianSharp.SmoothVariance
import BrownianSharp.GaussianGridStatistics
import BrownianSharp.ShellVariance

/-! Actual finite Gaussian rows generated by the concrete periodic smooth
plateau layer. The covariance is the full dot product of the smooth atom
coefficient vectors; no independent-row surrogate is introduced. -/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped BigOperators

namespace BrownianSharp

/-- The deterministic coefficient matrix of the concrete smooth layer. -/
def smoothStandardMatrix {d n : ℕ} {ι : Type*}
    (q : ι → MidpointGridIndex d n) (i : ι) (a : LayerIndex d n) : ℝ :=
  smoothLayerAtom smoothAtom (q i) a /
    Real.sqrt (smoothLayerVariance (q i))

/-- The standardized dot product of two actual smooth coefficient rows. -/
def smoothRowCorrelation {d n : ℕ}
    (q q' : MidpointGridIndex d n) : ℝ :=
  (∑ a : LayerIndex d n,
    smoothLayerAtom smoothAtom q a * smoothLayerAtom smoothAtom q' a) /
    (Real.sqrt (smoothLayerVariance q) * Real.sqrt (smoothLayerVariance q'))

/-- The smooth layer's normalized row, evaluated on independent standard
Gaussian coordinates indexed by its actual layer atoms. -/
def standardizedSmoothRow {d n : ℕ} {Ω : Type*}
    (G : LayerIndex d n → Ω → ℝ) (q : MidpointGridIndex d n) (ω : Ω) : ℝ :=
  GaussianRows.row G (smoothLayerAtom smoothAtom q) ω /
    Real.sqrt (smoothLayerVariance q)

theorem smoothLayerVariance_nonneg {d n : ℕ} (q : MidpointGridIndex d n) :
    0 ≤ smoothLayerVariance q :=
  Finset.sum_nonneg fun _ _ => sq_nonneg _

theorem smoothLayerAtom_nonneg {d n : ℕ}
    (q : MidpointGridIndex d n) (a : LayerIndex d n) :
    0 ≤ smoothLayerAtom smoothAtom q a := by
  unfold smoothLayerAtom
  apply Finset.prod_nonneg
  intro i hi
  exact (smoothAtom_bounds _).1

theorem smoothStandardMatrix_unit_rows {d n : ℕ} {ι : Type*}
    (q : ι → MidpointGridIndex d n)
    (hv : ∀ i, 0 < smoothLayerVariance (q i)) (i : ι) :
    ∑ a : LayerIndex d n, smoothStandardMatrix q i a ^ 2 = 1 := by
  simp only [smoothStandardMatrix, div_pow, ← Finset.sum_div]
  rw [Real.sq_sqrt (hv i).le]
  change smoothLayerVariance (q i) / smoothLayerVariance (q i) = 1
  exact div_self (hv i).ne'

theorem smoothStandardMatrix_dot {d n : ℕ} {ι : Type*}
    (q : ι → MidpointGridIndex d n) (i j : ι) :
    (∑ a : LayerIndex d n,
      smoothStandardMatrix q i a * smoothStandardMatrix q j a) =
        smoothRowCorrelation (q i) (q j) := by
  simp only [smoothStandardMatrix, smoothRowCorrelation, div_mul_div_comm,
    Finset.sum_div]

theorem standardizedSmoothRow_law {d n : ℕ} {Ω : Type*}
    [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    (G : LayerIndex d n → Ω → ℝ) (hG : ∀ a, Measurable (G a))
    (hIndep : iIndepFun G P)
    (hLaw : ∀ a, P.map (G a) = gaussianReal 0 1)
    (q : MidpointGridIndex d n) (hv : 0 < smoothLayerVariance q) :
    P.map (standardizedSmoothRow G q) = gaussianReal 0 1 := by
  exact GaussianRows.normalized_row_law G hG hLaw hIndep
    (smoothLayerAtom smoothAtom q) hv

theorem standardizedSmoothRow_covariance {d n : ℕ} {Ω : Type*}
    [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    (G : LayerIndex d n → Ω → ℝ) (hG : ∀ a, Measurable (G a))
    (hIndep : iIndepFun G P)
    (hLaw : ∀ a, P.map (G a) = gaussianReal 0 1)
    (q q' : MidpointGridIndex d n) :
    cov[standardizedSmoothRow G q, standardizedSmoothRow G q'; P] =
      smoothRowCorrelation q q' := by
  unfold standardizedSmoothRow smoothRowCorrelation
  rw [covariance_fun_div_left, covariance_fun_div_right,
    GaussianRows.row_covariance G hG hLaw hIndep]
  ring

theorem smoothRowCovarianceNumerator_nonneg {d n : ℕ}
    (q q' : MidpointGridIndex d n) :
    0 ≤ ∑ a : LayerIndex d n,
      smoothLayerAtom smoothAtom q a * smoothLayerAtom smoothAtom q' a :=
  Finset.sum_nonneg fun a _ => mul_nonneg
    (smoothLayerAtom_nonneg q a) (smoothLayerAtom_nonneg q' a)

/-- Prefix-shell covariance estimate for smooth rows above the proved
variance floor. -/
theorem smoothRowCorrelation_le_prefix {d n h : ℕ} (hd : 0 < d)
    (q q' : MidpointGridIndex d n) (c : Fin d →₀ ℕ)
    (hc : c.sum (fun _ x => x) = n + h)
    (hp : MidpointCommonPrefixProfile q q' c)
    (hq : smoothVarianceMeanLowerBound d n / 2 ≤ smoothLayerVariance q)
    (hq' : smoothVarianceMeanLowerBound d n / 2 ≤ smoothLayerVariance q') :
    smoothRowCorrelation q q' ≤
      2 ^ (d + 1) *
        (Nat.min (Nat.choose (n + d - 1) (d - 1))
          (Nat.choose (h + d - 1) (d - 1)) : ℝ) /
          (Nat.choose (n + d - 1) (d - 1) : ℝ) := by
  let m := smoothVarianceMeanLowerBound d n
  let C : ℝ := Nat.choose (n + d - 1) (d - 1)
  have hm : 0 < m := by simpa [m] using smoothVarianceMeanLowerBound_pos hd
  have hC : 0 < C := by
    dsimp [C]
    exact_mod_cast (Nat.choose_pos (show d - 1 ≤ n + d - 1 by omega))
  have hvq : 0 < smoothLayerVariance q := (half_pos hm).trans_le hq
  have hvq' : 0 < smoothLayerVariance q' := (half_pos hm).trans_le hq'
  have hprod : m / 2 ≤ Real.sqrt (smoothLayerVariance q) *
      Real.sqrt (smoothLayerVariance q') := by
    have hroot := Real.sqrt_le_sqrt hq
    have hroot' := Real.sqrt_le_sqrt hq'
    have hmul := mul_le_mul hroot hroot' (Real.sqrt_nonneg _)
      (Real.sqrt_nonneg _)
    have hsquare : Real.sqrt (m / 2) * Real.sqrt (m / 2) = m / 2 :=
      Real.mul_self_sqrt (by positivity)
    nlinarith [hsquare]
  have hsumAbs := smoothLayerPair_abs_sum_le hd smoothAtom
    (fun x hx => smoothAtom_support x hx) smoothAtom_abs_le_one q q' c hc hp
  have hnumAbs : |∑ a : LayerIndex d n,
      smoothLayerAtom smoothAtom q a * smoothLayerAtom smoothAtom q' a| ≤
        (Nat.min (Nat.choose (n + d - 1) (d - 1))
          (Nat.choose (h + d - 1) (d - 1)) : ℝ) := by
    calc
      |∑ a, smoothLayerAtom smoothAtom q a * smoothLayerAtom smoothAtom q' a|
          ≤ ∑ a, |smoothLayerAtom smoothAtom q a * smoothLayerAtom smoothAtom q' a| :=
            Finset.abs_sum_le_sum_abs _ _
      _ ≤ _ := hsumAbs
  have hnum := smoothRowCovarianceNumerator_nonneg q q'
  have hbound :
      (∑ a : LayerIndex d n,
        smoothLayerAtom smoothAtom q a * smoothLayerAtom smoothAtom q' a) ≤
        (Nat.min (Nat.choose (n + d - 1) (d - 1))
          (Nat.choose (h + d - 1) (d - 1)) : ℝ) := by
    exact le_trans (le_abs_self _) hnumAbs
  have hquot : smoothRowCorrelation q q' ≤
      (Nat.min (Nat.choose (n + d - 1) (d - 1))
        (Nat.choose (h + d - 1) (d - 1)) : ℝ) / (m / 2) := by
    unfold smoothRowCorrelation
    calc
      _ ≤ (∑ a : LayerIndex d n,
          smoothLayerAtom smoothAtom q a * smoothLayerAtom smoothAtom q' a) /
            (m / 2) :=
        div_le_div_of_nonneg_left hnum (by positivity) hprod
      _ ≤ _ := div_le_div_of_nonneg_right hbound (by positivity)
  have hm_eq : m = (1 / 2 : ℝ) ^ d * C := by
    simp [m, C, smoothVarianceMeanLowerBound]
  rw [hm_eq] at hquot
  have hden : (1 / 2 : ℝ) ^ d * C / 2 = C / (2 : ℝ) ^ (d + 1) := by
    rw [show (1 / 2 : ℝ) ^ d = ((2 : ℝ) ^ d)⁻¹ by
      rw [one_div, inv_pow]]
    rw [show (2 : ℝ) ^ (d + 1) = 2 * 2 ^ d by rw [pow_succ]; ring]
    field_simp
    <;> ring
  have hquot' : smoothRowCorrelation q q' ≤
      2 ^ (d + 1) * (Nat.min (Nat.choose (n + d - 1) (d - 1))
        (Nat.choose (h + d - 1) (d - 1)) : ℝ) / C := by
    calc
      _ ≤ (Nat.min (Nat.choose (n + d - 1) (d - 1))
          (Nat.choose (h + d - 1) (d - 1)) : ℝ) /
            ((1 / 2 : ℝ) ^ d * C / 2) := hquot
      _ = _ := by rw [hden]; field_simp [ne_of_gt hC]
  simpa [mul_comm] using hquot'

/-- The actual smooth good-grid covariance is controlled by the exact
common-prefix shell. -/
theorem smoothGoodRowCorrelation_le_prefix {d n h : ℕ} (hd : 0 < d)
    (q q' : SmoothGoodGrid d n) (c : Fin d →₀ ℕ)
    (hc : c.sum (fun _ x => x) = n + h)
    (hp : MidpointCommonPrefixProfile q.1 q'.1 c) :
    smoothRowCorrelation q.1 q'.1 ≤
      2 ^ (d + 1) *
        (Nat.min (Nat.choose (n + d - 1) (d - 1))
          (Nat.choose (h + d - 1) (d - 1)) : ℝ) /
          (Nat.choose (n + d - 1) (d - 1) : ℝ) := by
  exact smoothRowCorrelation_le_prefix hd q.1 q'.1 c hc hp q.2 q'.2

/-- The deterministic matrix of standardized smooth-layer rows on the good
midpoint set. -/
def smoothGoodMatrix (d n : ℕ) :
    SmoothGoodGrid d n → LayerIndex d n → ℝ :=
  smoothStandardMatrix (fun q : SmoothGoodGrid d n => q.1)

theorem smoothGoodGrid_variance_pos {d n : ℕ} (hd : 0 < d)
    (q : SmoothGoodGrid d n) : 0 < smoothLayerVariance q.1 :=
  (half_pos (smoothVarianceMeanLowerBound_pos hd)).trans_le q.2

theorem smoothGoodMatrix_unit_rows {d n : ℕ} (hd : 0 < d)
    (q : SmoothGoodGrid d n) :
    ∑ a : LayerIndex d n, smoothGoodMatrix d n q a ^ 2 = 1 :=
  smoothStandardMatrix_unit_rows _ (smoothGoodGrid_variance_pos hd) q

theorem smoothGoodMatrix_nonzero {d n : ℕ} (hd : 0 < d) :
    ∃ q a, smoothGoodMatrix d n q a ≠ 0 := by
  letI := smoothGoodGrid_nonempty (d := d) (n := n) hd
  by_contra h
  push_neg at h
  obtain ⟨q⟩ := ‹Nonempty (SmoothGoodGrid d n)›
  have hn := smoothGoodMatrix_unit_rows hd q
  simp only [h, zero_pow (by norm_num : (2 : ℕ) ≠ 0), Finset.sum_const_zero] at hn
  norm_num at hn

theorem smoothGoodMatrix_row_hasLaw {d n : ℕ} (hd : 0 < d)
    (q : SmoothGoodGrid d n) :
    HasLaw (fun x : LayerIndex d n → ℝ =>
      ∑ a, smoothGoodMatrix d n q a * x a)
      (gaussianReal 0 1) (productStandardGaussian (LayerIndex d n)) :=
  normalized_matrix_row_hasLaw _ (smoothGoodMatrix_unit_rows hd) q

theorem smoothGoodMatrix_power_mean {d n p : ℕ} (hd : 0 < d)
    (hM : standardGaussianMoment p ≠ 0) :
    (∫ x : LayerIndex d n → ℝ,
      normalizedPowerAverage
        (fun q x => ∑ a, smoothGoodMatrix d n q a * x a)
        p (standardGaussianMoment p) x
        ∂productStandardGaussian (LayerIndex d n)) = 1 := by
  letI := smoothGoodGrid_nonempty (d := d) (n := n) hd
  exact normalized_matrix_power_average_mean _ (smoothGoodMatrix_unit_rows hd) p hM

theorem smoothGoodMatrix_power_memLp_two {d n p : ℕ} (hd : 0 < d) :
    MemLp (normalizedPowerAverage
      (fun q x => ∑ a, smoothGoodMatrix d n q a * x a)
      p (standardGaussianMoment p)) 2
      (productStandardGaussian (LayerIndex d n)) := by
  classical
  unfold normalizedPowerAverage
  have h := (memLp_finsetSum (Finset.univ : Finset (SmoothGoodGrid d n))
      (fun q _ => normalized_matrix_row_power_memLp_two
        (smoothGoodMatrix d n) (smoothGoodMatrix_unit_rows (d := d) (n := n) hd) q p)).const_mul
      (((Fintype.card (SmoothGoodGrid d n) : ℝ) *
        standardGaussianMoment p)⁻¹)
  simpa only [Finset.sum_const_zero, div_eq_mul_inv, mul_comm] using h

theorem smoothGoodMatrix_power_nonneg {d n p : ℕ} (heven : Even p)
    (hM : 0 < standardGaussianMoment p)
    (x : LayerIndex d n → ℝ) :
    0 ≤ normalizedPowerAverage
      (fun q x => ∑ a, smoothGoodMatrix d n q a * x a)
      p (standardGaussianMoment p) x := by
  unfold normalizedPowerAverage
  apply div_nonneg
  · apply Finset.sum_nonneg
    intro i hi
    exact heven.pow_nonneg _
  · positivity

theorem smoothGoodMatrix_power_covariance {d n : ℕ}
    (q q' : SmoothGoodGrid d n) :
    (∑ a : LayerIndex d n,
      smoothGoodMatrix d n q a * smoothGoodMatrix d n q' a) =
        smoothRowCorrelation q.1 q'.1 :=
  smoothStandardMatrix_dot (fun q : SmoothGoodGrid d n => q.1) q q'

end BrownianSharp
