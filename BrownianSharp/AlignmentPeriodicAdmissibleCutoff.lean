import Mathlib.Analysis.SpecialFunctions.SmoothTransition
import Mathlib.Analysis.SpecificLimits.Basic
import Mathlib.Tactic
import BrownianSharp.SmoothResolution
import BrownianSharp.ScalarProfileKernel
import BrownianSharp.ScalarKernelL1
import BrownianSharp.ScalarPolynomialKernel
import BrownianSharp.TensorBlockKernelLp
import BrownianSharp.AlignmentPeriodicFourierReconstruction
import BrownianSharp.AlignmentMaternComplexWindow

/-! A parameterized admissible scalar cutoff and the generic identities for
its dyadic resolution. These are the structural starting point for comparing
two choices of smooth cutoff. -/

noncomputable section
open MeasureTheory
open UnitAddTorus
open scoped ENNReal

local instance cutoffFact : Fact (1 ≤ (2 : ℝ≥0∞)) := ⟨by norm_num⟩
local instance : MeasureSpace UnitAddCircle := ⟨AddCircle.haarAddCircle⟩
local instance : IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (IsProbabilityMeasure AddCircle.haarAddCircle)
local instance (d : ℕ) : IsProbabilityMeasure
    (volume : Measure (UnitAddTorus (Fin d))) := by
  change IsProbabilityMeasure
    (Measure.pi fun _ : Fin d => (AddCircle.haarAddCircle : Measure UnitAddCircle))
  infer_instance
local instance (d : ℕ) : Measure.IsAddHaarMeasure
    (volume : Measure (UnitAddTorus (Fin d))) := by
  change Measure.IsAddHaarMeasure
    (Measure.pi fun _ : Fin d => (AddCircle.haarAddCircle : Measure UnitAddCircle))
  infer_instance

namespace BrownianSharp.AlignmentPeriodicAdmissibleCutoff

/-- Smooth even cutoff with the same plateau, support, and range conditions
as the concrete cutoff used by `SmoothResolution`. -/
structure AdmissibleCutoff where
  value : ℝ → ℝ
  smooth : ContDiff ℝ (⊤ : ℕ∞) value
  even : ∀ x, value (-x) = value x
  one_of_abs_le_one : ∀ x, |x| ≤ 1 → value x = 1
  zero_of_two_le_abs : ∀ x, 2 ≤ |x| → value x = 0

/-- The already certified normalization is an instance of the generic
admissibility structure. -/
def smoothResolutionCutoff : AdmissibleCutoff where
  value := BrownianSharp.SmoothResolution.cutoff
  smooth := BrownianSharp.SmoothResolution.cutoff_smooth
  even := BrownianSharp.SmoothResolution.cutoff_even
  one_of_abs_le_one := by
    intro x hx
    exact BrownianSharp.SmoothResolution.cutoff_eq_one hx
  zero_of_two_le_abs := by
    intro x hx
    exact BrownianSharp.SmoothResolution.cutoff_eq_zero hx

/-- The scalar dyadic pieces generated by an admissible cutoff. -/
def scalarBlock (φ : AdmissibleCutoff) (s : ℕ) (ξ : ℝ) : ℝ :=
  if s = 0 then φ.value ξ else
    φ.value (ξ / (2 : ℝ)^s) - φ.value (ξ / (2 : ℝ)^(s-1))

/-- Compact profile of a positive-scale dyadic cutoff difference. -/
def differenceProfile (φ : AdmissibleCutoff) (ξ : ℝ) : ℝ :=
  φ.value ξ - φ.value (2*ξ)

theorem differenceProfile_smooth (φ : AdmissibleCutoff) :
    ContDiff ℝ (⊤ : ℕ∞) (differenceProfile φ) := by
  unfold differenceProfile
  exact φ.smooth.sub (φ.smooth.comp (by fun_prop))

theorem differenceProfile_eq_zero_of_four_le_abs (φ : AdmissibleCutoff)
    {ξ : ℝ} (hξ : 4 ≤ |ξ|) : differenceProfile φ ξ = 0 := by
  have h1 : φ.value ξ = 0 := φ.zero_of_two_le_abs ξ (by linarith)
  have h2 : φ.value (2*ξ) = 0 := by
    apply φ.zero_of_two_le_abs
    rw [abs_mul, abs_of_pos (by norm_num : (0:ℝ)<2)]
    nlinarith [hξ]
  simp [differenceProfile, h1, h2]

theorem differenceProfile_hasCompactSupport (φ : AdmissibleCutoff) :
    HasCompactSupport (differenceProfile φ) := by
  apply HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall (0:ℝ) 4)
  intro ξ hξ
  change differenceProfile φ ξ ≠ 0 at hξ
  have hball : |ξ| ≤ 4 := by
    by_contra h
    have houtside : 4 < |ξ| := lt_of_not_ge h
    have h1 : φ.value ξ = 0 := φ.zero_of_two_le_abs ξ (by linarith)
    have h2 : φ.value (2*ξ) = 0 := by
      apply φ.zero_of_two_le_abs
      rw [abs_mul, abs_of_pos (by norm_num : (0:ℝ)<2)]
      nlinarith [houtside]
    exact hξ (by simp [differenceProfile, h1, h2])
  simpa [Metric.mem_closedBall, dist_eq_norm, Real.norm_eq_abs] using hball

theorem scalarBlock_rescale (φ : AdmissibleCutoff) (t : ℕ) (ht : 0 < t)
    (ξ : ℝ) :
    scalarBlock φ t ((2 : ℝ)^t * ξ) = differenceProfile φ ξ := by
  have ht1 : 1 ≤ t := by omega
  have hpow : (2 : ℝ)^t = (2 : ℝ)^(t-1)*2 := by
    calc
      (2 : ℝ)^t = (2 : ℝ)^((t-1)+1) := by congr 1; omega
      _ = (2 : ℝ)^(t-1)*2 := by rw [pow_succ]
  have hpos : 0 < (2 : ℝ)^(t-1) := by positivity
  unfold scalarBlock differenceProfile
  rw [if_neg (Nat.ne_of_gt ht)]
  have hfirst : (2:ℝ)^t*ξ/(2:ℝ)^t=ξ := by field_simp
  have hsecond : (2:ℝ)^t*ξ/(2:ℝ)^(t-1)=2*ξ := by rw [hpow]; field_simp
  rw [hfirst,hsecond]

theorem scalarBlock_smoothResolution_eq (s : ℕ) (ξ : ℝ) :
    scalarBlock smoothResolutionCutoff s ξ =
      BrownianSharp.SmoothResolution.scalarBlock s ξ := rfl

theorem scalarBlock_sum (φ : AdmissibleCutoff) (N : ℕ) (ξ : ℝ) :
    (∑ s ∈ Finset.range (N + 1), scalarBlock φ s ξ) =
      φ.value (ξ / (2 : ℝ)^N) := by
  induction N with
  | zero => simp [scalarBlock]
  | succ N ih =>
    rw [Finset.sum_range_succ, ih]
    simp only [scalarBlock, Nat.succ_ne_zero, ite_false, Nat.add_sub_cancel]
    ring

theorem scalarBlock_even (φ : AdmissibleCutoff) (s : ℕ) (ξ : ℝ) :
    scalarBlock φ s (-ξ) = scalarBlock φ s ξ := by
  unfold scalarBlock
  split_ifs with hs
  · simp [φ.even]
  · rw [show -ξ / (2:ℝ)^s = -(ξ / (2:ℝ)^s) by ring,
      show -ξ / (2:ℝ)^(s-1) = -(ξ / (2:ℝ)^(s-1)) by ring,
      φ.even, φ.even]

theorem scalarBlock_eq_zero_of_two_pow_le_abs (φ : AdmissibleCutoff)
    (s : ℕ) {ξ : ℝ} (hξ : (2:ℝ)^(s+1) ≤ |ξ|) :
    scalarBlock φ s ξ = 0 := by
  have hupper : φ.value (ξ / (2:ℝ)^s) = 0 := by
    apply φ.zero_of_two_le_abs
    rw [abs_div, abs_of_pos (by positivity : (0:ℝ)<2^s)]
    apply (le_div_iff₀ (by positivity : (0:ℝ)<2^s)).2
    simpa [pow_succ, mul_comm] using hξ
  by_cases hs : s=0
  · subst s
    simpa [scalarBlock] using hupper
  · have hpow : (2:ℝ)^(s-1) ≤ (2:ℝ)^s :=
      pow_le_pow_right₀ (by norm_num) (by omega)
    have hlower : φ.value (ξ / (2:ℝ)^(s-1)) = 0 := by
      apply φ.zero_of_two_le_abs
      rw [abs_div, abs_of_pos (by positivity : (0:ℝ)<2^(s-1))]
      apply (le_div_iff₀ (by positivity : (0:ℝ)<2^(s-1))).2
      have hξ' : 2*(2:ℝ)^s ≤ |ξ| := by simpa [pow_succ, mul_comm] using hξ
      nlinarith
    simp [scalarBlock, hs, hupper, hlower]

def scalarBlockKernel (φ : AdmissibleCutoff) (s : ℕ) : C(UnitAddCircle, ℂ) :=
  ScalarKernelL1.polynomialKernel (ScalarAtomVariance.scalarFrequencyBox s)
    (fun k => (scalarBlock φ s (k:ℝ) : ℂ))

theorem scalarBlockKernel_coefficient (φ : AdmissibleCutoff) (s : ℕ) (k : ℤ) :
    fourierCoeff (scalarBlockKernel φ s) k = (scalarBlock φ s (k:ℝ) : ℂ) := by
  apply ScalarKernelL1.polynomialKernel_coefficient_of_support
  intro k hk
  have hout : (2:ℝ)^(s+1) ≤ |(k:ℝ)| := by
    simp only [ScalarAtomVariance.scalarFrequencyBox, Finset.mem_Icc,
      not_and_or, not_le] at hk
    rcases hk with hk | hk
    · have hcast : (k:ℝ) < -((2:ℝ)^(s+1)) := by exact_mod_cast hk
      exact le_trans (by linarith) (neg_le_abs _)
    · have hcast : (2:ℝ)^(s+1) < (k:ℝ) := by exact_mod_cast hk
      exact hcast.le.trans (le_abs_self _)
  exact_mod_cast scalarBlock_eq_zero_of_two_pow_le_abs φ s hout

theorem scalarBlock_eq_differenceProfile_sample (φ : AdmissibleCutoff)
    (s : ℕ) (hs : 0 < s) (k : ℤ) :
    scalarBlock φ s (k:ℝ) =
      scalarProfileSample (differenceProfile φ) (2^s) k.natAbs := by
  have hNcast : ((2^s : ℕ) : ℝ) = (2:ℝ)^s := by norm_cast
  have hpos : 0 < (2:ℝ)^s := by positivity
  have hnonneg : 0 ≤ (k.natAbs:ℝ) := Nat.cast_nonneg _
  have harg : (2:ℝ)^s * ((k.natAbs:ℝ)/(2:ℝ)^s) = (k.natAbs:ℝ) := by
    field_simp
  have hsample := scalarBlock_rescale φ s hs ((k.natAbs:ℝ)/(2:ℝ)^s)
  rw [harg] at hsample
  cases k with
  | ofNat n =>
      rw [scalarProfileSample, hNcast]
      simpa using hsample
  | negSucc n =>
      have hcast : (Int.negSucc n:ℝ) = -((n+1:ℕ):ℝ) := by simp
      rw [hcast, scalarBlock_even φ s]
      have hnat : (Int.negSucc n).natAbs = n+1 := by simp
      rw [hnat, scalarProfileSample, hNcast]
      simpa using hsample

theorem differenceProfile_hasCompactSupport_and_C2 (φ : AdmissibleCutoff) :
    ContDiff ℝ 2 (differenceProfile φ) ∧ HasCompactSupport (differenceProfile φ) := by
  exact ⟨(differenceProfile_smooth φ).of_le (by norm_num), differenceProfile_hasCompactSupport φ⟩

theorem exists_admissibleScalarBlockKernel_uniform_L1_bound (φ : AdmissibleCutoff) :
    ∃ L : ℝ, 0 ≤ L ∧ ∀ s : ℕ,
      (∫ x : UnitAddCircle, ‖scalarBlockKernel φ s x‖
        ∂AddCircle.haarAddCircle) ≤ L := by
  obtain ⟨Lp, hLp, hprofile⟩ := ScalarKernelL1.exists_uniform_norm_integral_bound
    ((differenceProfile_smooth φ).of_le (by simp)) (differenceProfile_hasCompactSupport φ)
  have hcutoffComp : HasCompactSupport φ.value := by
    apply HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall (0 : ℝ) 2)
    intro ξ hξ
    change φ.value ξ ≠ 0 at hξ
    by_contra hnorm
    have hnorm' : ¬ |ξ| ≤ 2 := by
      intro h
      apply hnorm
      simpa [Metric.mem_closedBall, dist_eq_norm, Real.norm_eq_abs] using h
    exact hξ (φ.zero_of_two_le_abs ξ (le_of_not_ge hnorm'))
  obtain ⟨Lc, hLc, hcutoff⟩ := ScalarKernelL1.exists_uniform_norm_integral_bound
    ((φ.smooth).of_le (by simp)) hcutoffComp
  refine ⟨max Lp Lc, le_max_of_le_left hLp, ?_⟩
  intro s
  by_cases hs : s=0
  · subst s
    have hcoeff : ∀ k : ℤ, fourierCoeff (scalarBlockKernel φ 0) k =
        (scalarProfileSample φ.value 1 k.natAbs : ℂ) := by
      intro k
      rw [scalarBlockKernel_coefficient]
      cases k with
      | ofNat n => simp [scalarBlock, scalarProfileSample]
      | negSucc n =>
          simp only [scalarBlock, if_true, scalarProfileSample, Nat.cast_one,
            div_one, Int.natAbs_negSucc, Int.cast_negSucc]
          rw [φ.even ((n+1:ℕ):ℝ)]
    have hb := hcutoff 1 (by norm_num) (scalarBlockKernel φ 0) hcoeff
    exact hb.trans (le_max_right _ _)
  · have hspos : 0<s := Nat.pos_of_ne_zero hs
    let N : ℕ := 2^s
    have hN : 1≤N := by dsimp [N]; exact Nat.one_le_pow s 2 (by omega)
    have hcoeff : ∀ k : ℤ, fourierCoeff (scalarBlockKernel φ s) k =
        (scalarProfileSample (differenceProfile φ) N k.natAbs : ℂ) := by
      intro k
      rw [scalarBlockKernel_coefficient, scalarBlock_eq_differenceProfile_sample φ s hspos]
    have hb := hprofile N hN (scalarBlockKernel φ s) hcoeff
    exact hb.trans (le_max_left _ _)

def admissibleCrossTensorSymbol {d : ℕ} (φ ψ : AdmissibleCutoff)
    (s t : Fin d → ℕ) (k : Fin d → ℤ) : ℂ :=
  ∏ i, ((scalarBlock φ (s i) (k i:ℝ) : ℂ) *
    (scalarBlock ψ (t i) (k i:ℝ) : ℂ))

/-- The smooth block associated with an arbitrary admissible cutoff. -/
def admissibleBlock {d : ℕ} (φ : AdmissibleCutoff) (s : Fin d → ℕ)
    (f : BrownianSharp.Torus.RealPeriodic d) :
    C(UnitAddTorus (Fin d), ℂ) :=
  BrownianSharp.Torus.torusFourierPolynomial
    (BrownianSharp.SmoothResolution.frequencyBox s)
    (fun k => ((∏ i, scalarBlock φ (s i) (k i : ℝ)) : ℂ) *
      BrownianSharp.Torus.realPeriodicFourierCoeff f k)

theorem admissibleBlock_coefficient {d : ℕ} (φ : AdmissibleCutoff)
    (s : Fin d → ℕ) (f : BrownianSharp.Torus.RealPeriodic d)
    (k : Fin d → ℤ) :
    UnitAddTorus.mFourierCoeff (admissibleBlock φ s f) k =
      ((∏ i, scalarBlock φ (s i) (k i : ℝ)) : ℂ) *
        BrownianSharp.Torus.realPeriodicFourierCoeff f k := by
  rw [admissibleBlock, BrownianSharp.AlignmentPeriodicFourierReconstruction.fourierPolynomial_coefficient]
  split_ifs with hk
  · rfl
  · have hnot : ¬ ∀ i, k i ∈ Finset.Icc
        (-((2:ℤ)^(s i+1))) ((2:ℤ)^(s i+1)) := by
      simpa [BrownianSharp.SmoothResolution.frequencyBox] using hk
    obtain ⟨i, hi⟩ := not_forall.mp hnot
    have hout : (2:ℝ)^(s i+1) ≤ |(k i:ℝ)| := by
      simp only [Finset.mem_Icc, not_and_or, not_le] at hi
      rcases hi with hi | hi
      · have h : (k i:ℝ) < -((2:ℝ)^(s i+1)) := by exact_mod_cast hi
        exact (by linarith : (2:ℝ)^(s i+1) ≤ -(k i:ℝ)).trans (neg_le_abs _)
      · have h : (2:ℝ)^(s i+1) < (k i:ℝ) := by exact_mod_cast hi
        exact h.le.trans (le_abs_self _)
    have hz := scalarBlock_eq_zero_of_two_pow_le_abs φ (s i) hout
    have hprod : ∏ j, scalarBlock φ (s j) (k j:ℝ) = 0 :=
      Finset.prod_eq_zero (Finset.mem_univ i) hz
    have hprodC : (∏ j, (scalarBlock φ (s j) (k j:ℝ) : ℂ)) = 0 := by
      exact_mod_cast hprod
    rw [hprodC]
    simp

/-- A cross block is the finite Fourier multiplier obtained by applying the
first cutoff block to the block of the second cutoff. -/
def admissibleCrossBlock {d : ℕ} (φ ψ : AdmissibleCutoff)
    (s t : Fin d → ℕ) (f : BrownianSharp.Torus.RealPeriodic d) :
    C(UnitAddTorus (Fin d), ℂ) :=
  BrownianSharp.Torus.torusFourierPolynomial
    (BrownianSharp.SmoothResolution.frequencyBox (fun i => max (s i) (t i)))
    (fun k => admissibleCrossTensorSymbol φ ψ s t k *
      BrownianSharp.Torus.realPeriodicFourierCoeff f k)

theorem admissibleCrossBlock_coefficient {d : ℕ} (φ ψ : AdmissibleCutoff)
    (s t : Fin d → ℕ) (f : BrownianSharp.Torus.RealPeriodic d)
    (k : Fin d → ℤ) :
    UnitAddTorus.mFourierCoeff (admissibleCrossBlock φ ψ s t f) k =
      admissibleCrossTensorSymbol φ ψ s t k *
        BrownianSharp.Torus.realPeriodicFourierCoeff f k := by
  rw [admissibleCrossBlock, BrownianSharp.AlignmentPeriodicFourierReconstruction.fourierPolynomial_coefficient]
  split_ifs with hk
  · rfl
  · have hnot : ¬ ∀ i, k i ∈ Finset.Icc
        (-((2:ℤ)^(max (s i) (t i)+1))) ((2:ℤ)^(max (s i) (t i)+1)) := by
      simpa [BrownianSharp.SmoothResolution.frequencyBox] using hk
    obtain ⟨i, hi⟩ := not_forall.mp hnot
    have hout : (2:ℝ)^(max (s i) (t i)+1) ≤ |(k i:ℝ)| := by
      simp only [Finset.mem_Icc, not_and_or, not_le] at hi
      rcases hi with hi | hi
      · have h : (k i:ℝ) < -((2:ℝ)^(max (s i) (t i)+1)) := by exact_mod_cast hi
        exact (by linarith : (2:ℝ)^(max (s i) (t i)+1) ≤ -(k i:ℝ)).trans (neg_le_abs _)
      · have h : (2:ℝ)^(max (s i) (t i)+1) < (k i:ℝ) := by exact_mod_cast hi
        exact h.le.trans (le_abs_self _)
    have hzero : scalarBlock φ (s i) (k i:ℝ)=0 ∨ scalarBlock ψ (t i) (k i:ℝ)=0 := by
      by_cases hs : s i ≤ t i
      · right
        apply scalarBlock_eq_zero_of_two_pow_le_abs ψ (t i)
        simpa [max_eq_right hs] using hout
      · left
        apply scalarBlock_eq_zero_of_two_pow_le_abs φ (s i)
        simpa [max_eq_left (le_of_not_ge hs)] using hout
    rcases hzero with hz | hz
    · have hprod : ∏ j, (scalarBlock φ (s j) (k j:ℝ) *
          scalarBlock ψ (t j) (k j:ℝ)) = 0 :=
        Finset.prod_eq_zero (Finset.mem_univ i) (by simp [hz])
      have hprodC : (∏ j, ((scalarBlock φ (s j) (k j:ℝ) : ℂ) *
          (scalarBlock ψ (t j) (k j:ℝ) : ℂ))) = 0 := by exact_mod_cast hprod
      simp only [admissibleCrossTensorSymbol, ← map_prod, ← map_mul]
      rw [hprodC]
      simp
    · have hprod : ∏ j, (scalarBlock φ (s j) (k j:ℝ) *
          scalarBlock ψ (t j) (k j:ℝ)) = 0 :=
        Finset.prod_eq_zero (Finset.mem_univ i) (by simp [hz])
      have hprodC : (∏ j, ((scalarBlock φ (s j) (k j:ℝ) : ℂ) *
          (scalarBlock ψ (t j) (k j:ℝ) : ℂ))) = 0 := by exact_mod_cast hprod
      simp only [admissibleCrossTensorSymbol, ← map_prod, ← map_mul]
      rw [hprodC]
      simp

private def admissibleLocalIndices {d : ℕ} (s : Fin d → ℕ) : Finset (Fin d → ℕ) :=
  Fintype.piFinset (fun i => Finset.range (s i + 3))

private theorem scalarBlock_partition_after (φ ψ : AdmissibleCutoff)
    (s : ℕ) (ξ : ℝ) (hξ : scalarBlock φ s ξ ≠ 0) :
    scalarBlock φ s ξ *
      (∑ t ∈ Finset.range (s+3), scalarBlock ψ t ξ) = scalarBlock φ s ξ := by
  have hsupport : |ξ| < (2:ℝ)^(s+1) := by
    by_contra h
    have h' : (2:ℝ)^(s+1) ≤ |ξ| := le_of_not_gt h
    exact hξ (scalarBlock_eq_zero_of_two_pow_le_abs φ s h')
  rw [scalarBlock_sum]
  have hden : (2:ℝ)^(s+2) > 0 := by positivity
  have hpowle : (2:ℝ)^(s+1) ≤ (2:ℝ)^(s+2) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  have harg : |ξ / (2:ℝ)^(s+2)| ≤ 1 := by
    rw [abs_div, abs_of_pos hden]
    apply (div_le_one hden).2
    exact hsupport.le.trans hpowle
  have hcut : ψ.value (ξ/(2:ℝ)^(s+2)) = 1 := ψ.one_of_abs_le_one _ harg
  rw [hcut]
  ring

private theorem scalarBlock_eq_zero_of_abs_le_lower (φ : AdmissibleCutoff)
    {s : ℕ} (hs : 2 ≤ s) {ξ : ℝ} (hξ : |ξ| ≤ (2:ℝ)^(s-2)) :
    scalarBlock φ s ξ = 0 := by
  have hpow1 : (2:ℝ)^(s-2) ≤ (2:ℝ)^s :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  have hpow2 : (2:ℝ)^(s-2) ≤ (2:ℝ)^(s-1) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  have hden1 : 0 < (2:ℝ)^s := by positivity
  have hden2 : 0 < (2:ℝ)^(s-1) := by positivity
  have harg1 : |ξ/(2:ℝ)^s| ≤ 1 := by
    rw [abs_div, abs_of_pos hden1]
    exact (div_le_one hden1).2 (hξ.trans hpow1)
  have harg2 : |ξ/(2:ℝ)^(s-1)| ≤ 1 := by
    rw [abs_div, abs_of_pos hden2]
    exact (div_le_one hden2).2 (hξ.trans hpow2)
  unfold scalarBlock
  rw [if_neg (by omega : s ≠ 0)]
  rw [φ.one_of_abs_le_one _ harg1, φ.one_of_abs_le_one _ harg2]
  ring

private theorem scalarBlock_product_eq_zero_of_gap (φ ψ : AdmissibleCutoff)
    {s t : ℕ} (hgap : t + 2 < s) (ξ : ℝ) :
    scalarBlock φ s ξ * scalarBlock ψ t ξ = 0 := by
  have hs : 2 ≤ s := by omega
  have hscale : (2:ℝ)^(t+1) ≤ (2:ℝ)^(s-2) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  by_cases hlow : |ξ| ≤ (2:ℝ)^(s-2)
  · rw [scalarBlock_eq_zero_of_abs_le_lower φ hs hlow]
    simp
  · have habs : (2:ℝ)^(s-2) < |ξ| := lt_of_not_ge hlow
    have hhigh : (2:ℝ)^(t+1) ≤ |ξ| := hscale.trans habs.le
    rw [scalarBlock_eq_zero_of_two_pow_le_abs ψ t hhigh]
    simp

theorem admissibleCrossBlock_eq_zero_of_far_lower {d : ℕ}
    (φ ψ : AdmissibleCutoff) (s t : Fin d → ℕ)
    (i : Fin d) (hgap : t i + 2 < s i)
    (f : BrownianSharp.Torus.RealPeriodic d) :
    admissibleCrossBlock φ ψ s t f = 0 := by
  classical
  apply ContinuousMap.ext
  intro x
  simp only [admissibleCrossBlock,
    BrownianSharp.AlignmentMaternComplexWindow.torusFourierPolynomial_apply]
  apply Finset.sum_eq_zero
  intro k hk
  have hz := scalarBlock_product_eq_zero_of_gap φ ψ hgap (k i:ℝ)
  have hprod : ∏ j, (scalarBlock φ (s j) (k j:ℝ) *
      scalarBlock ψ (t j) (k j:ℝ)) = 0 :=
    Finset.prod_eq_zero (Finset.mem_univ i) hz
  simp only [admissibleCrossTensorSymbol]
  have hprodC : ∏ j, ((scalarBlock φ (s j) (k j:ℝ) : ℂ) *
      (scalarBlock ψ (t j) (k j:ℝ) : ℂ)) = 0 := by exact_mod_cast hprod
  rw [hprodC]
  simp

/-- Exact finite-overlap reconstruction: one cutoff block is the sum of its
cross blocks against all lower-cutoff blocks whose coordinate indices are at
most two levels above it. -/
theorem admissibleBlock_eq_local_cross_sum {d : ℕ} (φ ψ : AdmissibleCutoff)
    (s : Fin d → ℕ) (f : BrownianSharp.Torus.RealPeriodic d) :
    admissibleBlock φ s f =
      ∑ t ∈ admissibleLocalIndices s, admissibleCrossBlock φ ψ s t f := by
  classical
  have hcoeff : ∀ k : Fin d → ℤ,
      UnitAddTorus.mFourierCoeff (admissibleBlock φ s f) k =
        UnitAddTorus.mFourierCoeff
          (∑ t ∈ admissibleLocalIndices s, admissibleCrossBlock φ ψ s t f) k := by
    intro k
    let A : Fin d → ℝ := fun i => scalarBlock φ (s i) (k i:ℝ)
    let B : Fin d → ℕ → ℝ := fun i t => scalarBlock ψ t (k i:ℝ)
    have hsum (i : Fin d) : A i * (∑ t ∈ Finset.range (s i+3), B i t) = A i := by
      by_cases hAi : A i = 0
      · simp [hAi]
      · exact scalarBlock_partition_after φ ψ (s i) (k i:ℝ) (by simpa [A] using hAi)
    have hprod : (∑ t ∈ admissibleLocalIndices s,
        ∏ i, (A i * B i (t i))) = ∏ i, A i := by
      dsimp [admissibleLocalIndices]
      rw [← Finset.prod_univ_sum (fun i => Finset.range (s i+3))
        (fun i n => A i * B i n)]
      apply Finset.prod_congr rfl
      intro i hi
      rw [← Finset.mul_sum]
      exact hsum i
    have htarget : (∑ t ∈ admissibleLocalIndices s,
        admissibleCrossTensorSymbol φ ψ s t k) =
        (∏ i, (scalarBlock φ (s i) (k i:ℝ) : ℂ)) := by
      simp only [admissibleCrossTensorSymbol]
      push_cast
      exact_mod_cast hprod
    let coeff := BrownianSharp.AlignmentPeriodicFourierReconstruction.fourierCoefficientCLM k
    have hleft := BrownianSharp.AlignmentPeriodicFourierReconstruction.fourierCoefficientCLM_apply
      k (admissibleBlock φ s f)
    have hright := BrownianSharp.AlignmentPeriodicFourierReconstruction.fourierCoefficientCLM_apply
      k (∑ t ∈ admissibleLocalIndices s, admissibleCrossBlock φ ψ s t f)
    calc
      _ = coeff (admissibleBlock φ s f) := hleft.symm
      _ = coeff (∑ t ∈ admissibleLocalIndices s,
          admissibleCrossBlock φ ψ s t f) := by
        rw [hleft, admissibleBlock_coefficient]
        dsimp [coeff]
        rw [map_sum]
        simp_rw [BrownianSharp.AlignmentPeriodicFourierReconstruction.fourierCoefficientCLM_apply,
          admissibleCrossBlock_coefficient]
        rw [← Finset.sum_mul, htarget]
      _ = _ := by simpa only [ContinuousMap.coe_sum] using hright
  have hLp : (admissibleBlock φ s f).toLp 2 volume ℂ =
      (∑ t ∈ admissibleLocalIndices s, admissibleCrossBlock φ ψ s t f).toLp 2 volume ℂ := by
    apply mFourierBasis.repr.injective
    ext k
    simp only [mFourierBasis_repr, mFourierCoeff_toLp]
    simpa only [ContinuousMap.coe_sum] using hcoeff k
  exact ContinuousMap.toLp_injective volume hLp

end BrownianSharp.AlignmentPeriodicAdmissibleCutoff
